# From the OAuth Client ID you create in Google Cloud Console (Desktop app type).
GOOGLE_OAUTH_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# Generate this by running: node scripts/get-refresh-token.js <CLIENT_ID> <CLIENT_SECRET>
GOOGLE_OAUTH_REFRESH_TOKEN=1//your-refresh-token

# The Drive folder ID where everything is stored - any folder in your own Drive.
# Found in the folder's URL: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
